{
  "name": "@qman/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js",
    "dev": "tsc --build && node dist/index.js",
    "migrate": "tsc --build && node dist/migrate.js",
    "verify:db": "vitest run src/integration.test.ts src/provisioning.integration.test.ts src/end-to-end.integration.test.ts --root ../..",
    "bootstrap": "tsc --build && node dist/bootstrap-cli.js"
  },
  "dependencies": {
    "@qman/domain": "*",
    "@qman/persistence": "*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
