{
  "name": "qman",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "QMan — Intelligent Patient Flow & Operations Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "tsc --build",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p apps/web/tsconfig.json",
    "dev": "npm run dev -w @qman/web",
    "verify": "npm run typecheck && npm run build && npm run build -w @qman/web && npm test"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
