# Copy to .env and adjust. Never commit .env or .env.local.

# ─────────────────────────────────────────────────────────────────── API server

# PostgreSQL connection string. Required.
#
# Any PostgreSQL 13 or later: a managed instance at Neon, Render, Railway,
# DigitalOcean, RDS or Azure, or a server on the hospital's own network. The
# schema uses no extensions, so nothing beyond this line changes between them.
DATABASE_URL=postgres://qman:password@localhost:5432/qman

# development or production. Anything other than "development" is treated as
# production, so a deployment that forgets this variable gets the stricter
# posture rather than the weaker one.
# NODE_ENV=production

# Origins allowed to make state-changing requests, comma separated.
#
# Required in production, with no default: a permissive default would disable
# CSRF protection for every deployment that did not know to set it. In
# development it defaults to the Vite dev server ports.
QMAN_ALLOWED_ORIGINS=https://qman.hospital.example

# The hospital this server serves. Required.
#
# Every request is scoped to it, and it is never inferred from the request.
QMAN_HOSPITAL_ID=

# Whether to connect with TLS. Defaults to on unless DATABASE_URL is localhost,
# which matches how managed providers and local servers are usually configured.
# DATABASE_SSL=true

# Accepts a certificate that does not verify. Defaults to false, and should stay
# there for every managed provider — all of them present a certificate that
# verifies. Turning it on leaves the connection encrypted but unauthenticated,
# which protects against someone reading the traffic and not at all against
# someone answering in the database's place. The one legitimate use is a
# hospital's own server with a self-signed certificate.
# DATABASE_SSL_INSECURE=false

# DATABASE_POOL_SIZE=10
# HOST=0.0.0.0
# PORT=3001

# debug, info, warn or error. Quiet by default: debug logging left on in
# production is logging nobody reads, filling a disk a hospital depends on.
# LOG_LEVEL=info

# Whether session cookies are marked Secure. Defaults to on in production and
# off in development.
#
# A Secure cookie is never sent over plain HTTP, so http://localhost needs it
# off or sign-in silently fails. In production it is a floor rather than a
# default: setting it to false is refused at startup.
# QMAN_SECURE_COOKIES=true

# ────────────────────────────────────────────────────────────────── web app

# Password for the development seed accounts (ifeoma, adams, admin).
#
# Leave unset and a random password is generated on each start and printed to
# the browser console. Set it only for a shared development environment where a
# stable login is convenient. It has no effect once the web app talks to the API,
# at which point the seeded browser accounts are removed entirely.
# VITE_SEED_PASSWORD=
