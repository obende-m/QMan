# Copy to .env and adjust. Never commit .env or .env.local.

# ─────────────────────────────────────────────────────────────────── API server

# PostgreSQL connection string. Required.
#
# Any PostgreSQL 13 or later: a managed instance at Neon, Render, Railway,
# DigitalOcean, RDS or Azure, or a server on the hospital's own network. The
# schema uses no extensions, so nothing beyond this line changes between them.
DATABASE_URL=postgres://qman:password@localhost:5432/qman

# The hospital this server serves. Required.
#
# Every request is scoped to it, and it is never inferred from the request.
QMAN_HOSPITAL_ID=

# Whether to connect with TLS. Defaults to on unless DATABASE_URL is localhost,
# which matches how managed providers and local servers are usually configured.
# DATABASE_SSL=true

# DATABASE_POOL_SIZE=10
# HOST=0.0.0.0
# PORT=3001

# debug, info, warn or error. Quiet by default: debug logging left on in
# production is logging nobody reads, filling a disk a hospital depends on.
# LOG_LEVEL=info

# Whether session cookies are marked Secure. Defaults to true.
#
# A Secure cookie is never sent over plain HTTP, so local development over
# http://localhost needs this off. Never set it to false on a deployed server:
# session cookies would then travel in the clear.
# QMAN_SECURE_COOKIES=true

# ────────────────────────────────────────────────────────────────── web app

# Password for the development seed accounts (ifeoma, adams, admin).
#
# Leave unset and a random password is generated on each start and printed to
# the browser console. Set it only for a shared development environment where a
# stable login is convenient. It has no effect once the web app talks to the API,
# at which point the seeded browser accounts are removed entirely.
# VITE_SEED_PASSWORD=
